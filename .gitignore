*.pt
*.pth
*.ckpt
*.bin
*.safetensors
*.onnx
checkpoints/
saved_models/
weights/

# Training logs & experiments
runs/
wandb/
lightning_logs/
tensorboard/
*.log

# Hugging Face & PyTorch cache
.cache/
hf_cache/

# ==============================================================================
# 5. BẢO MẬT & FILE MÔI TRƯỜNG (SECRETS & ENVIRONMENT)
# ==============================================================================
.env
.env.local
.env.*.local
*.pem
credentials.json
*secret*
*token*

